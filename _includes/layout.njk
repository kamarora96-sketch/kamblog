<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or "Notes & Musings" }}</title>
  <style>
    *,
    *::before,
    *::after { box-sizing: border-box; }

    :root {
      --font-heading: Georgia, 'Times New Roman', Times, serif;
      --font-body: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    .vb-b1g,
    .vb-b1g * { box-sizing: border-box; }
    .vb-b1g input,
    .vb-b1g textarea,
    .vb-b1g select { font: inherit; }

    .vb-b1g {
      --vb-bg: #f6f5f1;
      --vb-surface: #ffffff;
      --vb-text: #1a1a40;
      --vb-text-soft: #5a5a7a;
      --vb-text-muted: #8a8aa0;
      --vb-accent: #dd9944;
      --vb-accent-2: #f27d72;
      --vb-border: #e8e6df;
      --vb-border-strong: #d5d2c8;
      --vb-radius: 4px;

      background: var(--vb-bg);
      color: var(--vb-text);
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.6;
      padding: 80px 24px;
      min-height: 100vh;
    }

    .vb-b1g__container { max-width: 720px; margin: 0 auto; }

    .vb-b1g__header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 24px;
      margin-bottom: 48px;
      padding-bottom: 28px;
      border-bottom: 1px solid var(--vb-border);
    }

    .vb-b1g__brand { flex: 1; min-width: 0; }

    .vb-b1g__eyebrow {
      font-family: var(--font-body);
      font-size: 13px;
      color: var(--vb-text-muted);
      margin: 0 0 12px;
      letter-spacing: 0.02em;
    }

    .vb-b1g__title {
      font-family: var(--font-heading);
      font-size: clamp(2.25rem, 5.5vw, 3.125rem);
      font-weight: 400;
      color: var(--vb-accent);
      letter-spacing: 0.02em;
      margin: 0 0 14px;
      line-height: 1.1;
      text-wrap: balance;
    }

    .vb-b1g__lede {
      font-family: var(--font-body);
      font-size: 17px;
      color: var(--vb-text-soft);
      margin: 0;
      max-width: 56ch;
      line-height: 1.55;
    }

    .vb-b1g__admin-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--vb-text);
      color: #fff;
      border-radius: var(--vb-radius);
      padding: 12px 20px;
      text-decoration: none;
      font-family: var(--font-body);
      font-size: 15px;
      font-weight: 500;
      white-space: nowrap;
      transition: background 0.2s ease, transform 0.2s ease;
    }

    .vb-b1g__admin-link:hover { background: #000; transform: translateY(-1px); }

    .vb-b1g__list {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .vb-b1g__empty {
      text-align: center;
      color: var(--vb-text-muted);
      padding: 60px 0;
      font-size: 16px;
      font-family: var(--font-body);
      margin: 0;
    }

    .vb-b1g__empty a {
      color: var(--vb-accent);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .vb-b1g__post {
      background: var(--vb-surface);
      border: 1px solid var(--vb-border);
      border-radius: var(--vb-radius);
      padding: 32px 32px 28px;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .vb-b1g__post:hover {
      border-color: var(--vb-border-strong);
      box-shadow: 0 1px 0 rgba(26, 26, 64, 0.02);
    }

    .vb-b1g__post-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
    }

    .vb-b1g__post-date {
      font-family: var(--font-body);
      font-size: 12px;
      color: var(--vb-text-muted);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .vb-b1g__post-title {
      font-family: var(--font-heading);
      font-size: clamp(1.5rem, 3.2vw, 1.875rem);
      font-weight: 400;
      color: var(--vb-accent);
      letter-spacing: 0.01em;
      margin: 0 0 8px;
      line-height: 1.2;
      text-wrap: balance;
    }

    .vb-b1g__post-subtitle {
      font-family: var(--font-body);
      font-size: 16px;
      color: var(--vb-accent-2);
      margin: 0 0 18px;
      line-height: 1.45;
      font-weight: 500;
    }

    .vb-b1g__post-body {
      font-family: var(--font-body);
      font-size: 16px;
      color: var(--vb-text);
      line-height: 1.7;
      text-wrap: pretty;
    }

    .vb-b1g__post-body p { margin: 0 0 14px; }
    .vb-b1g__post-body p:last-child { margin-bottom: 0; }
    .vb-b1g__post-body strong { font-weight: 600; }
    .vb-b1g__post-body a { color: var(--vb-accent-2); text-decoration: underline; text-underline-offset: 3px; }

    @media (max-width: 640px) {
      .vb-b1g { padding: 56px 20px; }
      .vb-b1g__header {
        flex-direction: column;
        align-items: stretch;
        gap: 20px;
        margin-bottom: 36px;
      }
      .vb-b1g__admin-link { justify-content: center; }
      .vb-b1g__post { padding: 24px 22px 22px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .vb-b1g *,
      .vb-b1g *::before,
      .vb-b1g *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body>
  {{ content | safe }}
</body>
</html>
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>Blog Admin</title>
  </head>
  <body>
    <script src="https://unpkg.com/decap-cms@^3.3.0/dist/decap-cms.js"></script>
  </body>
</html>
